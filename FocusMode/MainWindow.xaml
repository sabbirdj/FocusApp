<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FocusMode.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FocusMode">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0">
                <Viewbox Width="16" Height="16"><Path Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" /></Viewbox>
                <TextBlock Text="FocusMode" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                           
                <!-- Settings button moved to left side -->
                <Button x:Name="SettingsButton" 
                        VerticalAlignment="Center" 
                        Click="SettingsButton_Click"
                        Style="{StaticResource GhostButton}"
                        Padding="8" Height="32" Width="32">
                    <Viewbox Width="14" Height="14"><Path Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" /></Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content Frame -->
        <Frame x:Name="NavFrame" Grid.Row="1" />
    </Grid>
</Window>
