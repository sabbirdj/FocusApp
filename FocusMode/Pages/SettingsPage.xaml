<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FocusMode.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Background="Transparent" Padding="32,16,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Back button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
            <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Click="BackButton_Click"
                    Padding="8" Height="32" Width="32">
                <Viewbox Width="14" Height="14"><Path Data="M19 12H5 M12 19l-7-7 7-7" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" /></Viewbox>
            </Button>
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" MaxWidth="700">

                <!-- General Section -->
                <TextBlock Text="GENERAL" Style="{StaticResource StatLabel}" Margin="0,0,0,4" />

                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Launch at Windows startup" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Automatically start FocusMode when you log in" 
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LaunchAtStartupToggle" Grid.Column="1" Toggled="LaunchAtStartupToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Show system tray icon" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Keep FocusMode accessible from the system tray" 
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowTrayIconToggle" Grid.Column="1" Toggled="ShowTrayIconToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Focus Mode Section -->
                <TextBlock Text="FOCUS MODE" Style="{StaticResource StatLabel}" Margin="0,8,0,4" />

                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Preview before hibernating" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Show a preview of processes that will be hibernated before activating" 
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DryRunToggle" Grid.Column="1" Toggled="DryRunToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto-restore on exit" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Re-launch all hibernated apps when FocusMode exits" 
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoResumeToggle" Grid.Column="1" Toggled="AutoResumeToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Custom Whitelist Section -->
                <TextBlock Text="PROTECTED PROCESSES" Style="{StaticResource StatLabel}" Margin="0,8,0,4" />

                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="These processes will never be hibernated during Focus Mode" 
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WhitelistEntryBox" PlaceholderText="Process name (e.g. spotify)" 
                                     CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                     BorderBrush="{StaticResource CardBorderBrush}" />
                            <Button Content="Add" Grid.Column="1" Style="{StaticResource ScanButton}" Click="AddWhitelist_Click" />
                        </Grid>
                        <ListView x:Name="WhitelistListView" MaxHeight="200" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Grid.Column="1" Content="✕" 
                                                Click="RemoveWhitelist_Click" Tag="{Binding}"
                                                Background="Transparent" Foreground="{StaticResource DangerBrush}"
                                                Padding="4" MinWidth="0" MinHeight="0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Reset Section -->
                <Button Content="Reset to Defaults" Style="{StaticResource GhostButton}" 
                        HorizontalAlignment="Left" Click="ResetButton_Click" Margin="0,8,0,32" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

